{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/typescript-engineering-baseline/contract-manifest.schema.json",
  "title": "Engineering Baseline Contract Change Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "feature", "contracts"],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "feature": {
      "type": "string",
      "pattern": "^[0-9]{3}-[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "contracts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/contractChange"
      }
    }
  },
  "$defs": {
    "identifierList": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "contractChange": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "profile",
        "artifact",
        "artifactSha256",
        "selectors",
        "requirementIds",
        "successCriterionIds",
        "owners",
        "compatibility",
        "migration",
        "deprecation"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "profile": {
          "enum": ["openapi", "asyncapi", "graphql", "grpc"]
        },
        "artifact": {
          "type": "string",
          "minLength": 1
        },
        "artifactSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "selectors": {
          "$ref": "#/$defs/selectors"
        },
        "requirementIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^FR-[0-9]{3}$"
          }
        },
        "successCriterionIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^SC-[0-9]{3}$"
          }
        },
        "owners": {
          "type": "object",
          "additionalProperties": false,
          "required": ["provider", "consumers"],
          "properties": {
            "provider": {
              "$ref": "#/$defs/identifierList"
            },
            "consumers": {
              "$ref": "#/$defs/identifierList"
            }
          }
        },
        "compatibility": {
          "type": "object",
          "additionalProperties": false,
          "required": ["classification", "baseline", "rationale"],
          "properties": {
            "classification": {
              "enum": ["additive", "deprecation", "breaking"]
            },
            "baseline": {
              "type": ["string", "null"]
            },
            "rationale": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "migration": {
          "type": "object",
          "additionalProperties": false,
          "required": ["required", "strategy", "deadline", "rolloutNotes"],
          "properties": {
            "required": {
              "type": "boolean"
            },
            "strategy": {
              "type": "string",
              "minLength": 1
            },
            "deadline": {
              "type": ["string", "null"]
            },
            "rolloutNotes": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "deprecation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["deprecatedElements", "intendedRemovalRelease", "notes"],
          "properties": {
            "deprecatedElements": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "intendedRemovalRelease": {
              "type": ["string", "null"]
            },
            "notes": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "selectors": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "operations": {
          "$ref": "#/$defs/identifierList"
        },
        "messages": {
          "$ref": "#/$defs/identifierList"
        },
        "fields": {
          "$ref": "#/$defs/identifierList"
        },
        "types": {
          "$ref": "#/$defs/identifierList"
        },
        "rpcMethods": {
          "$ref": "#/$defs/identifierList"
        }
      }
    }
  }
}
