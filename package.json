{
  "name": "ts-baseline-docs",
  "version": "0.1.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p src/apps/web-vite/tsconfig.json && tsc --noEmit -p src/apps/web-next/tsconfig.json && tsc --noEmit -p tsconfig.storybook.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test --pass-with-no-tests",
    "start": "tsx src/apps/api/main.ts",
    "start:dev": "tsx watch src/apps/api/main.ts",
    "start:prod": "node dist/apps/api/main.js",
    "web:dev": "pnpm web:vite:dev",
    "web:build": "pnpm web:vite:build",
    "web:preview": "pnpm web:vite:preview",
    "web:vite:dev": "vite --config src/apps/web-vite/vite.config.ts",
    "web:vite:build": "vite --config src/apps/web-vite/vite.config.ts build",
    "web:vite:check-generated": "pnpm web:vite:build && git diff --exit-code -- src/apps/web-vite/route-tree.gen.ts",
    "web:vite:preview": "vite --config src/apps/web-vite/vite.config.ts preview",
    "web:next:dev": "next dev src/apps/web-next",
    "web:next:build": "next build src/apps/web-next",
    "web:next:start": "next start src/apps/web-next",
    "storybook:vite": "storybook dev --config-dir src/apps/web-vite/.storybook --port 6006",
    "storybook:next": "storybook dev --config-dir src/apps/web-next/.storybook --port 6007",
    "storybook:build:vite": "storybook build --config-dir src/apps/web-vite/.storybook --output-dir dist/storybook/web-vite",
    "storybook:build:next": "storybook build --config-dir src/apps/web-next/.storybook --output-dir dist/storybook/web-next",
    "test:storybook": "vitest run --config vitest.storybook.config.ts",
    "build": "tsc -p tsconfig.build.json",
    "openapi:generate": "tsx scripts/generate-openapi.ts",
    "openapi:check": "pnpm openapi:generate && git diff --exit-code docs/openapi/openapi.yaml docs/openapi/openapi.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "secrets:scan": "gitleaks git . --verbose --redact",
    "secrets:scan:staged": "gitleaks git . --staged --verbose --redact",
    "audit": "pnpm audit",
    "skills:check": "node scripts/validate-skills.mjs",
    "prepare": "lefthook install",
    "commitlint": "commitlint --edit"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@11.11.0",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.11.0",
      "onFail": "warn"
    }
  },
  "type": "module",
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^10.0.0",
    "@nestjs/testing": "^11.2.3",
    "@nogoo9/gitleaks": "8.30.1-post.2",
    "@playwright/test": "^1.62.0",
    "@storybook/addon-a11y": "^10.6.0",
    "@storybook/addon-vitest": "^10.6.0",
    "@storybook/nextjs-vite": "^10.6.0",
    "@storybook/react-vite": "^10.6.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/eslint-plugin-query": "^5.102.8",
    "@tanstack/router-plugin": "^1.168.36",
    "@testing-library/react": "^16.3.3",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/browser": "^4.1.10",
    "@vitest/browser-playwright": "^4.1.10",
    "@vitest/coverage-v8": "^4.1.10",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.0",
    "eslint-plugin-unicorn": "^65.0.1",
    "globals": "^17.8.0",
    "jsdom": "^30.0.1",
    "lefthook": "^2.1.10",
    "prettier": "^3.9.6",
    "shadcn": "^4.21.0",
    "storybook": "^10.6.0",
    "supertest": "^7.2.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.10",
    "yaml": "^2.9.0",
    "@nestjs/common": "^11.2.3",
    "@nestjs/core": "^11.2.3",
    "@nestjs/platform-express": "^11.2.3",
    "@tanstack/charts": "0.18.0",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-router": "^1.170.33",
    "@tanstack/react-table": "^9.2.4",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.2.6",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.43.0",
    "motion": "^13.2.0",
    "next": "^16.3.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.15"
  },
  "dependencies": {}
}
