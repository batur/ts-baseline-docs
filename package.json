{
  "name": "ts-baseline-docs",
  "version": "0.2.0",
  "description": "Executable TypeScript engineering baseline with living specifications, Cucumber, TDD, and contract-first delivery.",
  "main": "dist/index.js",
  "scripts": {
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test --pass-with-no-tests",
    "build": "tsc -p tsconfig.build.json",
    "spec:check": "node --import tsx tooling/engineering-baseline/src/cli.ts specification",
    "traceability:generate": "node --import tsx tooling/engineering-baseline/src/cli.ts traceability-generate",
    "traceability:check": "node --import tsx tooling/engineering-baseline/src/cli.ts traceability-check",
    "test:bdd:dry": "node --import tsx ./node_modules/@cucumber/cucumber/bin/cucumber.js --config cucumber.mjs --profile dry",
    "test:bdd": "node --import tsx ./node_modules/@cucumber/cucumber/bin/cucumber.js --config cucumber.mjs --profile default",
    "test:bdd:ready": "node --import tsx ./node_modules/@cucumber/cucumber/bin/cucumber.js --config cucumber.mjs --profile ready",
    "contracts:lint": "node scripts/engineering-baseline/contracts.mjs lint",
    "contracts:generate": "node scripts/engineering-baseline/contracts.mjs generate",
    "contracts:check-generated": "node scripts/engineering-baseline/contracts.mjs check-generated",
    "contracts:breaking": "node scripts/engineering-baseline/contracts.mjs breaking",
    "contracts:test": "node scripts/engineering-baseline/contracts.mjs test",
    "contracts:check": "node scripts/engineering-baseline/contracts.mjs check",
    "openapi:generate": "pnpm contracts:generate",
    "openapi:check": "pnpm contracts:check",
    "openapi:lint": "pnpm contracts:lint",
    "openapi:test": "pnpm contracts:test",
    "baseline:verify": "node scripts/engineering-baseline/verify.mjs",
    "baseline:check": "node scripts/engineering-baseline/verify.mjs --complete",
    "baseline:clean-checkout": "node scripts/engineering-baseline/clean-checkout.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "secrets:scan": "gitleaks git . --config .gitleaks.toml --verbose --redact",
    "secrets:scan:staged": "gitleaks git . --staged --config .gitleaks.toml --verbose --redact",
    "audit": "pnpm audit --prod --audit-level=high",
    "skills:check": "node scripts/validate-skills.mjs",
    "prepare": "lefthook install",
    "commitlint": "commitlint --edit"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@11.11.0",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.11.0",
      "onFail": "warn"
    }
  },
  "type": "module",
  "devDependencies": {
    "@asyncapi/cli": "6.0.2",
    "@asyncapi/modelina": "5.10.1",
    "@bufbuild/buf": "1.72.0",
    "@bufbuild/protobuf": "2.14.1",
    "@bufbuild/protoc-gen-es": "2.14.1",
    "@commitlint/cli": "21.2.1",
    "@commitlint/config-conventional": "21.2.0",
    "@cucumber/cucumber": "13.2.1",
    "@eslint/js": "9.39.5",
    "@faker-js/faker": "10.6.0",
    "@graphql-codegen/cli": "7.4.0",
    "@graphql-codegen/typescript": "6.1.0",
    "@graphql-codegen/typescript-operations": "6.1.6",
    "@graphql-eslint/eslint-plugin": "4.4.1",
    "@graphql-inspector/cli": "7.0.0",
    "@nogoo9/gitleaks": "8.30.1-post.2",
    "@playwright/test": "1.62.0",
    "@redocly/cli": "2.51.2",
    "@stoplight/prism-cli": "5.16.0",
    "@types/node": "26.1.2",
    "@vitest/coverage-v8": "4.1.10",
    "ajv": "8.17.1",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-unicorn": "65.0.1",
    "globals": "17.8.0",
    "graphql": "16.14.2",
    "lefthook": "2.1.10",
    "msw": "2.11.3",
    "orval": "8.30.0",
    "prettier": "3.9.6",
    "tsx": "4.23.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.10",
    "yaml": "2.9.0"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "zod": "4.4.3"
  }
}
