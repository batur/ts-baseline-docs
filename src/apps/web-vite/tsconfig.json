{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../../../tsconfig.frontend.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"]
    },
    "types": ["node", "vite/client"]
  },
  "include": ["**/*.ts", "**/*.tsx", ".storybook/**/*.ts", ".storybook/**/*.tsx", "vite.config.ts"],
  "exclude": ["node_modules", "dist"]
}
